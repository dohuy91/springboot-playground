@baseUrl = http://localhost:8080
@keycloakUrl = http://localhost:8081
@realm = playground
@clientId = springboot-playground-api
@username = playground-user
@password = playground
@accessToken = REPLACE_WITH_ACCESS_TOKEN

### Get access token
POST {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{clientId}}&username={{username}}&password={{password}}

### List products
GET {{baseUrl}}/api/products
Authorization: Bearer {{accessToken}}

### Get product by id
GET {{baseUrl}}/api/products/1
Authorization: Bearer {{accessToken}}

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Weekend Duffle",
  "description": "Canvas duffle with leather straps.",
  "price": 89.00,
  "sku": "DF-WEEKEND-009",
  "quantity": 14,
  "active": true
}

### Update product
PUT {{baseUrl}}/api/products/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Starter Backpack",
  "description": "Updated description.",
  "price": 64.99,
  "sku": "BP-STARTER-001",
  "quantity": 20,
  "active": true
}

### Delete product
DELETE {{baseUrl}}/api/products/1
Authorization: Bearer {{accessToken}}
